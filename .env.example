# ─────────────────────────────────────────────────────────────────────────────
# Imagica Holidays – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the CRM API running on Railway (no trailing slash)
# Example: https://your-crm-app.up.railway.app/api
VITE_CRM_BASE_URL=

# Shared secret / API key for the CRM webhook
VITE_CRM_API_KEY=

# WhatsApp number for the CTA button (country code + number, no +)
# Example: 919876543210  (91 = India code)
VITE_WHATSAPP_NUMBER=
